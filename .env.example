# ==============================================================================
# GlucoseSense / DIA-PREDICT — Environment Configuration Template
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development
DEBUG=true

# Client Web Application Port (Served by reverse-proxy dev server)
CLIENT_PORT=3000
PORT=3000

# Python Machine Learning Backend API Service Port
BACKEND_PORT=5000

# Network Bindings
HOST=0.0.0.0

# CORS Allowed Origin
CLIENT_URL=http://localhost:3000

# Machine Learning Artifact Paths (Relative to project root or absolute)
MODEL_PATH=ml/models/diabetes_model.pkl
DATASET_PATH=ml/data/diabetes.csv
METADATA_PATH=ml/models/model_metadata.json

# API Rate Limiting (Requests per minute per IP for prediction requests)
RATE_LIMIT_PER_MINUTE=120
